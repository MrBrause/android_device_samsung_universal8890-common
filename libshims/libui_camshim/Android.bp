cc_library_shared {
    name: "libui_camera_shim",
    vendor: true,
    compile_multilib: "both",
    srcs: ["fence_shim.cpp", "alloc_shim.cpp"],
    shared_libs: ["libui", "libsync", "liblog", "libutils"],
    // Put the shim into the global lookup group of the camera provider process,
    // so its Fence::wait() wins over libui's regardless of DT_NEEDED order.
    ldflags: ["-Wl,-z,global"],
    version_script: "exports.map",
}
